---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort();
---

<Layout title="Tags" description="List of tags used.">
  <Container>
    <div class="space-y-10 pt-20">
      <h1
        class="animate font-serif text-[32px] font-semibold text-[#211f1c] dark:text-white"
      >
        All Tags
      </h1>
      <div class="animate flex flex-wrap gap-2">
        {
          tags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="font-mono text-[11px] tracking-[0.08em] text-[#211f1c]/60 underline decoration-dotted underline-offset-4 transition-colors hover:text-[#211f1c] dark:text-white/60 dark:hover:text-white"
            >
              {tag}{" "}
              <span class="text-sm text-gray-600">
                ({posts.filter((post) => post.data.tags?.includes(tag)).length})
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</Layout>
