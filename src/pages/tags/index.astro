---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort();
---

<Layout title="Tags" description="List of tags used.">
  <Container>
    <section class="tag-directory" data-pagefind-ignore>
      <h1 class="page-heading">All Tags</h1>
      <ul class="tag-list">
        {
          tags.map((tag) => (
            <li>
              <a href={`/tags/${tag}`} class="tag-link">
                <span>{tag}</span>
                <span class="tag-count">
                  {`(${posts.filter((post) => post.data.tags?.includes(tag)).length})`}
                </span>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12h14m-6-6 6 6-6 6" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </Container>
</Layout>

<style>
  .tag-directory {
    padding-block: var(--space-8) var(--space-7);
  }

  .tag-directory h1 {
    margin: 0 0 var(--space-6);
  }

  .tag-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  .tag-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 20px;
    min-height: var(--space-7);
    align-items: center;
    gap: var(--space-4);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--motion-duration) var(--motion-ease);
  }

  .tag-link:hover,
  .tag-link:focus-visible {
    color: var(--color-accent);
  }

  .tag-count {
    color: var(--color-text-secondary);
    font-size: var(--font-size-meta);
  }

  .tag-link svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  .tag-link:hover svg,
  .tag-link:focus-visible svg {
    transform: translateX(4px);
  }
</style>
