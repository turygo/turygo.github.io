---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Pagefind from "@components/PageFind.astro";
import ReadingToolbar from "@components/ReadingToolbar.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
  reading?: boolean;
  hasToc?: boolean;
};

const { title, description, reading = false, hasToc = false } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <Head title={`${title} | ${SITE.TITLE}`} description={description} />
  </head>
  <body class:list={[reading && "reading-page"]}>
    <Header reading={reading} />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer reading={reading} />
    {reading && <ReadingToolbar hasToc={hasToc} />}
    <Pagefind />
  </body>
</html>
