---
import Search from "astro-pagefind/components/Search";
---

<aside data-pagefind-ignore>
  <dialog id="search-dialog" aria-label="搜索">
    <div class="search-dialog-header">
      <button
        type="button"
        class="control icon search-close"
        data-search-close
        aria-label="Press Esc or click anywhere to close"
        title="Press Esc or click anywhere to close"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>
    <div class="search-dialog-content">
      <Search
        id="search"
        className="pagefind-ui"
        uiOptions={{
          showImages: false,
          excerptLength: 15,
          resetStyles: false,
        }}
      />
      <div class="search-close-hint">
        Press <kbd>Esc</kbd> or click anywhere to close
      </div>
    </div>
  </dialog>
</aside>

<script>
  const initializedDialogs = new WeakSet<HTMLDialogElement>();
  const returnFocusTargets = new WeakMap<
    HTMLDialogElement,
    HTMLElement | null
  >();

  function currentDialog(): HTMLDialogElement | null {
    const dialog = document.getElementById("search-dialog");
    if (!(dialog instanceof HTMLDialogElement)) return null;

    if (!initializedDialogs.has(dialog)) {
      initializedDialogs.add(dialog);
      dialog.addEventListener("close", () => {
        const input = dialog.querySelector<HTMLInputElement>("#search input");
        if (input && input.value) {
          input.value = "";
          input.dispatchEvent(new Event("input", { bubbles: true }));
        }

        const returnTarget = returnFocusTargets.get(dialog);
        returnFocusTargets.delete(dialog);
        if (returnTarget?.isConnected) returnTarget.focus();
      });
    }

    return dialog;
  }

  function focusSearchInput(dialog: HTMLDialogElement) {
    dialog
      .querySelector<HTMLInputElement>("#search input")
      ?.focus({ preventScroll: true });
  }

  function openSearch(returnTarget: HTMLElement | null) {
    const dialog = currentDialog();
    if (!dialog) return;

    if (!dialog.open) {
      returnFocusTargets.set(dialog, returnTarget);
      dialog.showModal();
    }

    focusSearchInput(dialog);
    requestAnimationFrame(() => {
      const activeDialog = currentDialog();
      if (activeDialog?.open) focusSearchInput(activeDialog);
    });
  }

  function closeSearch(restoreFocus = true) {
    const dialog = currentDialog();
    if (!dialog) return;
    if (!restoreFocus) returnFocusTargets.set(dialog, null);
    if (!dialog.open) return;
    dialog.close();
  }

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const target = event.target;
    const trigger = target.closest<HTMLButtonElement>("#magnifying-glass");
    if (trigger) {
      event.preventDefault();
      openSearch(trigger);
      return;
    }

    const dialog = currentDialog();
    if (!dialog?.open) return;
    if (target === dialog) {
      closeSearch();
      return;
    }
    if (dialog.contains(target) && target.closest("[data-search-close]")) {
      closeSearch();
      return;
    }

    const resultLink = target.closest(".pagefind-ui__result-link");
    if (resultLink && dialog.contains(resultLink)) closeSearch();
  });

  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      openSearch(
        document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null,
      );
      return;
    }

    const target = event.target;
    const isEditing =
      target instanceof Element &&
      target.closest(
        'input, textarea, select, [contenteditable]:not([contenteditable="false"])',
      ) !== null;
    if (
      event.key === "/" &&
      !event.metaKey &&
      !event.ctrlKey &&
      !event.altKey &&
      !isEditing
    ) {
      event.preventDefault();
      openSearch(
        document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null,
      );
    }
  });

  document.addEventListener("astro:before-swap", () => closeSearch(false));
  document.addEventListener("astro:page-load", () => {
    const dialog = currentDialog();
    if (dialog?.open) {
      requestAnimationFrame(() => {
        const activeDialog = currentDialog();
        if (activeDialog?.open) focusSearchInput(activeDialog);
      });
    }
  });
</script>

<style is:global>
  #search-dialog {
    --pagefind-ui-font: var(--font-sans);
    --pagefind-ui-primary: var(--color-accent);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: var(--color-surface);
    --pagefind-ui-border: var(--color-line);
    --pagefind-ui-tag: var(--color-hover);
    --pagefind-ui-border-radius: var(--radius-control);

    box-sizing: border-box;
    width: min(680px, calc(100vw - 48px));
    max-width: 680px;
    max-height: calc(100dvh - 48px);
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-surface);
  }

  #search-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  #search-dialog::backdrop {
    background: color-mix(in srgb, var(--color-text) 36%, transparent);
  }

  #search-dialog .search-dialog-header {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--color-line);
  }

  #search-dialog .search-close svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.75;
  }

  #search-dialog .search-dialog-content {
    min-height: 0;
    overflow-y: auto;
    padding: var(--space-4) var(--space-5) var(--space-5);
  }
  .search-close-hint {
    margin-top: var(--space-4);
    color: var(--color-text-secondary);
    font-size: var(--font-size-meta);
    text-align: right;
  }

  #search {
    min-width: 0;
  }

  #search input,
  #search p {
    font-weight: 400;
  }

  #search .pagefind-ui__result-title {
    font-weight: 600;
  }

  #search .pagefind-ui__message {
    padding: 0 0 var(--space-3);
  }
</style>
