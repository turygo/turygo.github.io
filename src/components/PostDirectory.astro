---
import { type CollectionEntry, getCollection } from "astro:content";
import { BLOG } from "@consts";

const data = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

type Acc = {
  [year: string]: CollectionEntry<"blog">[];
};

const posts = data.reduce((acc: Acc, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(post);
  return acc;
}, {});

const years = Object.keys(posts).sort((a, b) => parseInt(b) - parseInt(a));

const numbers = new Map<string, string>();
data.forEach((post, i) => {
  numbers.set(post.id, String(i + 1).padStart(2, "0"));
});

const CN_DIGITS = "〇一二三四五六七八九";
const toCnYear = (year: string) =>
  year
    .split("")
    .map((d) => CN_DIGITS[Number(d)])
    .join("");

const pad2 = (n: number) => String(n).padStart(2, "0");
const fmtDate = (d: Date) =>
  `${d.getFullYear()}.${pad2(d.getMonth() + 1)}.${pad2(d.getDate())}`;
const description = BLOG.DESCRIPTION.replace(/[。.]$/, "");
---

<aside data-pagefind-ignore>
  <div class="animate pt-20 pb-16 text-center">
    <div
      class="font-mono text-[11px] font-medium tracking-[0.3em] text-[#211f1c]/40 uppercase dark:text-white/40"
    >
      Table of Contents
    </div>
    <h1
      class="mt-4 font-serif text-[46px] leading-[1.15] font-bold text-[#211f1c] dark:text-white"
    >
      目录
    </h1>
    <p class="mt-3.5 text-sm text-[#211f1c]/60 dark:text-white/60">
      {description} · 共 {data.length} 篇
    </p>
    <div
      aria-hidden="true"
      class="mt-[30px] font-serif text-[#211f1c]/40 dark:text-white/40"
    >
      ❧
    </div>
  </div>

  {
    years.map((year) => (
      <section class="animate mb-[72px]">
        <div class="mb-[34px] flex items-center gap-5">
          <span
            aria-hidden="true"
            class="h-[3px] flex-1 border-y border-[#211f1c]/15 dark:border-white/20"
          />
          <span class="pl-[0.34em] font-serif text-[15px] font-semibold tracking-[0.34em] text-[#211f1c] dark:text-white">
            {toCnYear(year)}
          </span>
          <span class="font-mono text-[11px] tracking-wider text-[#211f1c]/40 dark:text-white/40">
            {posts[year].length} 篇
          </span>
          <span
            aria-hidden="true"
            class="h-[3px] flex-1 border-y border-[#211f1c]/15 dark:border-white/20"
          />
        </div>
        <ul class="not-prose flex flex-col gap-[26px]">
          {posts[year].map((post) => (
            <li>
              <a href={`/${post.collection}/${post.id}`} class="group">
                <div class="grid grid-cols-[30px_minmax(0,1fr)] items-baseline gap-x-3 sm:flex sm:gap-3">
                  <span class="min-w-[30px] font-mono text-xs font-medium text-[#211f1c]/40 dark:text-white/40">
                    {numbers.get(post.id)}
                  </span>
                  <span class="min-w-0 font-serif text-[17px] leading-[1.5] font-semibold text-[#211f1c] decoration-1 underline-offset-4 group-hover:underline dark:text-white">
                    {post.data.title}
                  </span>
                  <span
                    aria-hidden="true"
                    class="hidden min-w-6 flex-1 -translate-y-[4px] border-b border-dotted border-[#211f1c]/40 sm:block dark:border-white/30"
                  />
                  <time
                    datetime={post.data.date.toISOString()}
                    class="col-start-2 mt-1 font-mono text-xs whitespace-nowrap text-[#211f1c]/60 sm:mt-0 dark:text-white/60"
                  >
                    {fmtDate(post.data.date)}
                  </time>
                </div>
                <p class="mt-1.5 ml-[42px] text-sm leading-7 text-[#211f1c]/60 dark:text-white/60">
                  {post.data.description}
                </p>
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="mt-1 ml-[42px] flex gap-2.5">
                    {post.data.tags.map((tag) => (
                      <span class="font-mono text-[10px] font-medium tracking-[0.14em] text-[#211f1c]/40 uppercase dark:text-white/40">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</aside>
