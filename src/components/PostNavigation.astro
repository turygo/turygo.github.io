---
const { prevPost, nextPost } = Astro.props;
const hasPrevious = Boolean(prevPost?.id);
const hasNext = Boolean(nextPost?.id);
---

{
  (hasPrevious || hasNext) && (
    <nav class="post-navigation">
      {hasPrevious ? (
        <a href={`/blog/${prevPost.id}`} class="post-navigation-link">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 12H5m6-6-6 6 6 6" />
          </svg>
          <span>{prevPost.data.title}</span>
        </a>
      ) : (
        <span class="post-navigation-placeholder" aria-hidden="true" />
      )}
      {hasNext ? (
        <a
          href={`/blog/${nextPost.id}`}
          class="post-navigation-link post-navigation-next"
        >
          <span>{nextPost.data.title}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14m-6-6 6 6-6 6" />
          </svg>
        </a>
      ) : (
        <span class="post-navigation-placeholder" aria-hidden="true" />
      )}
    </nav>
  )
}

<style>
  .post-navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    border-top: 1px solid var(--color-line);
    padding-top: var(--space-4);
  }

  .post-navigation-link {
    display: flex;
    min-width: 0;
    min-height: 44px;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-3);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--motion-duration) var(--motion-ease);
  }

  .post-navigation-link:hover,
  .post-navigation-link:focus-visible {
    color: var(--color-accent);
  }

  .post-navigation-link span {
    overflow-wrap: anywhere;
  }

  .post-navigation-link svg {
    width: 16px;
    height: 16px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .post-navigation-next {
    justify-content: flex-end;
    text-align: right;
  }
</style>
