---
import { SITE, SOCIALS } from "@consts";

interface Props {
  reading?: boolean;
}

const { reading = false } = Astro.props;
---

<footer class="site-footer" data-pagefind-ignore>
  <div class={reading ? "reading-container" : "site-shell"}>
    <div class="footer-row">
      <span class="footer-copy">
        &copy; {new Date().getFullYear()} · {SITE.TITLE}
      </span>
      <nav class="footer-links">
        {
          SOCIALS.map((social) => (
            <a
              href={social.HREF}
              target="_blank"
              rel="noopener noreferrer"
              class="text-link"
            >
              {social.NAME}
            </a>
          ))
        }
        <a
          href="/rss.xml"
          target="_blank"
          rel="noopener noreferrer"
          class="text-link"
        >
          RSS
        </a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    padding-bottom: var(--space-6);
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }

  .footer-copy {
    color: var(--color-text-secondary);
    font-size: var(--font-size-meta);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-4);
  }
</style>
