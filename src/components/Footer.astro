---
import Container from "@components/Container.astro";
import { SITE, SOCIALS } from "@consts";
---

<footer class="animate mt-20">
  <Container>
    <div
      class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 border-t border-black/15 pt-[26px] pb-11 text-center font-mono text-[11px] tracking-[0.1em] text-[#211f1c]/40 dark:border-white/20 dark:text-white/40"
    >
      <span>&copy; {new Date().getFullYear()} · {SITE.TITLE}</span>
      {
        SOCIALS.map((social) => (
          <a
            href={social.HREF}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-[#211f1c] dark:hover:text-white"
          >
            {social.NAME}
          </a>
        ))
      }
      <a
        href="/rss.xml"
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-[#211f1c] dark:hover:text-white"
      >
        RSS
      </a>
      <button
        id="theme-toggle"
        aria-label="切换主题"
        class="cursor-pointer transition-colors hover:text-[#211f1c] dark:hover:text-white"
      >
        Theme
      </button>
    </div>
  </Container>
</footer>
