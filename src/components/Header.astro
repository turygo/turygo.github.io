---
import Container from "@components/Container.astro";
import { SITE } from "@consts";
---

<header transition:persist>
  <Container>
    <div class="flex items-baseline justify-between py-6">
      <a
        href="/"
        class="font-serif text-sm font-semibold tracking-[0.05em] text-[#211f1c] transition-colors hover:text-black dark:text-white dark:hover:text-white"
      >
        {SITE.TITLE}
      </a>
      <nav
        class="flex items-center gap-[18px] text-[13px] text-[#211f1c]/60 dark:text-white/60"
      >
        <a
          href="/blog"
          class="transition-colors hover:text-[#211f1c] dark:hover:text-white"
        >
          归档
        </a>
        <button
          id="magnifying-glass"
          aria-label="搜索"
          class="cursor-pointer transition-colors hover:text-[#211f1c] dark:hover:text-white"
        >
          搜索
        </button>
      </nav>
    </div>
  </Container>
</header>
