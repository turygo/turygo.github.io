---
interface Props {
  type?: "default" | "info" | "warning" | "error";
}

type CalloutType = NonNullable<Props["type"]>;

const { type = "default" } = Astro.props;
const emojis: Record<CalloutType, string> = {
  default: "💡",
  info: "ℹ️",
  warning: "⚠️",
  error: "🚨",
};
---

<div class="not-prose callout" role="note">
  <span class="callout-icon">{emojis[type]}</span>
  <div class="callout-content">
    <slot />
  </div>
</div>

<style>
  .callout {
    display: flex;
    gap: var(--space-3);
    margin-block: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-control);
    padding: var(--space-4);
    background: var(--color-surface);
    color: var(--color-text);
  }

  .callout-icon {
    display: grid;
    flex: none;
    place-items: start center;
    color: var(--color-text-secondary);
    font-size: 1.25rem;
  }

  .callout-content {
    min-width: 0;
  }
</style>
