---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"blog">;
};

const { entry } = Astro.props as {
  entry: CollectionEntry<"blog">;
};
---

<a
  href={`/${entry.collection}/${entry.id}`}
  class="not-prose group block border-t border-[#211f1c]/15 py-5 transition-colors dark:border-white/20"
>
  <div
    class="font-serif text-[17px] font-semibold text-[#211f1c] underline-offset-4 group-hover:underline dark:text-white"
  >
    {entry.data.title}
  </div>
  <div class="mt-1.5 text-sm leading-7 text-[#211f1c]/60 dark:text-white/60">
    {entry.data.description}
  </div>
</a>
